# Clerk (identity only; roles and permissions live in the API database).
# Use a production Clerk instance on your root domain so one session works
# across app.<root> and every <slug>.<root> workspace.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_your_publishable_key_here
CLERK_SECRET_KEY=sk_test_your_secret_key_here
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# apps/api base URL (server-side calls)
API_BASE_URL=http://localhost:3000

# Workspaces are subdomains: <slug>.<root domain>. Point a wildcard DNS record
# (*.<root domain>) at this app; nothing is created per business at runtime.
# The app host is app.<root domain>. Dev example (add to your hosts file or use
# a wildcard resolver): dev.local:3001
NEXT_PUBLIC_ROOT_DOMAIN=dev.local:3001
NEXT_PUBLIC_WEB_PROTOCOL=http
