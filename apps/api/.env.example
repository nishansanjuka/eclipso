# Database Configuration
DATABASE_URL=postgresql://username:password@localhost:5432/database_name

# Clerk Authentication
CLERK_PUBLISHABLE_KEY=pk_test_your_publishable_key_here
CLERK_SECRET_KEY=sk_test_your_secret_key_here
CLERK_WEBHOOK_SIGNING_SECRET=whsec_your_webhook_signing_secret_here

# Membership/permission cache TTL in ms (0 = always read the DB)
ACCESS_CACHE_TTL_MS=30000

# Invitations: emails go out through resend.com. Without a key they are only
# logged, so local development works without an account.
RESEND_API_KEY=re_your_resend_api_key_here
MAIL_FROM=Aperture <invites@your-verified-domain.com>
# Workspaces live at <slug>.<WEB_ROOT_DOMAIN> (invitation links point there)
WEB_ROOT_DOMAIN=dev.local:3001
WEB_PROTOCOL=http
INVITATION_TTL_DAYS=7

# S3 bucket for business logo uploads (presigned direct-to-browser). Unset
# disables the upload endpoint (returns 503) but nothing else breaks.
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_access_key_id_here
AWS_SECRET_ACCESS_KEY=your_secret_access_key_here
AWS_S3_BUCKET=your_bucket_name_here
# Optional: defaults to https://<bucket>.s3.<region>.amazonaws.com — set this
# to a CDN/custom domain in front of the bucket instead.
AWS_S3_PUBLIC_URL=

# Test User (for development/testing)
TEST_CLERK_USER_ID=user_your_test_user_id_here

# Postman API Documentation
POSTMAN_API_KEY=PMAK-your_postman_api_key_here
POSTMAN_COLLECTION_ID=your_postman_collection_id_here
API_JSON_URL=http://localhost:3000/api-json
API_URL=http://localhost:3000